---
import Header from './Header.astro';
import VideoResizerApp from './VideoResizerApp';
import { getLocalePath, getTranslation, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const homeUrl = getLocalePath(locale);
---

<div class="first-fold-shell">
  <Header locale={locale} />

  <!-- STRICT 100dvh FIRST FOLD: Dedicated strictly to Primary H1 + Interactive Resizer Box Div -->
  <main class="flex-1 flex flex-col justify-center px-3 sm:px-6 py-4 sm:py-6">
    <section aria-labelledby="hero-heading" class="w-full max-w-6xl mx-auto">
      <h1 id="hero-heading" class="hero-h1 text-center mb-4 sm:mb-6">
        {t.hero.h1}
      </h1>
      <VideoResizerApp client:load t={t} />
    </section>
  </main>
</div>

<!-- BELOW THE FOLD: Breadcrumbs, Keyword-Rich Semantic Guides, Comparison Table & FAQ -->
<div class="border-t" style="border-color: var(--border-soft);">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-16">
    <!-- 1:1 Visual Breadcrumbs matching BreadcrumbList JSON-LD -->
    <nav aria-label="Breadcrumb" class="text-sm font-bold flex flex-wrap items-center gap-2">
      <a href={homeUrl} class="hover:underline" style="color: var(--text-secondary);">
        {t.breadcrumbs.home}
      </a>
      <span aria-hidden="true" class="opacity-60">&gt;</span>
      <a href="#tools-guide" class="hover:underline" style="color: var(--text-secondary);">
        {t.breadcrumbs.tools}
      </a>
      <span aria-hidden="true" class="opacity-60">&gt;</span>
      <span aria-current="page" style="color: var(--text-primary);">{t.breadcrumbs.current}</span>
    </nav>

    <!-- Smart Scale, Pad & Crop Architecture -->
    <section id="tools-guide" aria-labelledby="explain-heading">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2
          id="explain-heading"
          class="text-2xl sm:text-3xl font-extrabold mb-3 tracking-tight"
          style="color: var(--text-primary);"
        >
          {t.explain.sectionTitle}
        </h2>
        <p class="ui-lead-text font-medium opacity-90" style="color: var(--text-muted);">
          {t.explain.sectionSubtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <article
          class="p-6 sm:p-7 rounded-3xl border-2"
          style="background-color: var(--bg-surface-card); border-color: var(--border-color); box-shadow: var(--shadow-card);"
        >
          <div
            class="w-14 h-14 rounded-2xl flex items-center justify-center mb-4"
            style="background-color: var(--highlight-pill-badge);"
          >
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="color: var(--text-secondary);">
              <path d="M6 2v14a2 2 0 0 0 2 2h14" />
              <path d="M18 22V8a2 2 0 0 0-2-2H2" />
            </svg>
          </div>
          <h3 class="text-xl font-extrabold mb-2" style="color: var(--text-primary);">
            {t.explain.cropCardTitle}
          </h3>
          <p class="text-base leading-relaxed opacity-90" style="color: var(--text-primary);">
            {t.explain.cropCardText}
          </p>
        </article>

        <article
          class="p-6 sm:p-7 rounded-3xl border-2"
          style="background-color: var(--bg-surface-card); border-color: var(--border-color); box-shadow: var(--shadow-card);"
        >
          <div
            class="w-14 h-14 rounded-2xl flex items-center justify-center mb-4"
            style="background-color: var(--highlight-pill-badge);"
          >
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="color: var(--text-secondary);">
              <rect x="3" y="3" width="18" height="18" rx="3" />
              <rect x="7" y="7" width="10" height="10" rx="1.5" />
            </svg>
          </div>
          <h3 class="text-xl font-extrabold mb-2" style="color: var(--text-primary);">
            {t.explain.padCardTitle}
          </h3>
          <p class="text-base leading-relaxed opacity-90" style="color: var(--text-primary);">
            {t.explain.padCardText}
          </p>
        </article>

        <article
          class="p-6 sm:p-7 rounded-3xl border-2"
          style="background-color: var(--bg-surface-card); border-color: var(--border-color); box-shadow: var(--shadow-card);"
        >
          <div
            class="w-14 h-14 rounded-2xl flex items-center justify-center mb-4"
            style="background-color: var(--highlight-pill-badge);"
          >
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" style="color: var(--text-secondary);">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              <path d="m9 12 2 2 4-4" />
            </svg>
          </div>
          <h3 class="text-xl font-extrabold mb-2" style="color: var(--text-primary);">
            {t.explain.privacyCardTitle}
          </h3>
          <p class="text-base leading-relaxed opacity-90" style="color: var(--text-primary);">
            {t.explain.privacyCardText}
          </p>
        </article>
      </div>
    </section>

    <!-- 3-Step HowTo Section matching HowTo JSON-LD 1:1 -->
    <section aria-labelledby="howto-heading">
      <div class="text-center max-w-3xl mx-auto mb-8">
        <h2
          id="howto-heading"
          class="text-2xl sm:text-3xl font-extrabold mb-3 tracking-tight"
          style="color: var(--text-primary);"
        >
          {t.howTo.title}
        </h2>
        <p class="ui-lead-text font-medium opacity-90" style="color: var(--text-muted);">
          {t.howTo.subtitle}
        </p>
      </div>

      <ol class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {t.howTo.steps.map((stepText, idx) => (
          <li
            class="p-6 rounded-3xl border-2 flex flex-col gap-3"
            style="background-color: var(--bg-surface-card); border-color: var(--border-soft); box-shadow: var(--shadow-card);"
          >
            <span
              class="w-10 h-10 rounded-xl inline-flex items-center justify-center text-lg font-black"
              style="background-color: var(--btn-primary-bg); color: var(--btn-primary-text);"
            >
              {idx + 1}
            </span>
            <p class="text-base font-semibold leading-relaxed" style="color: var(--text-primary);">
              {stepText}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Social Aspect Ratio & Video Size Resizer Guide -->
    <section aria-labelledby="formats-heading">
      <div class="text-center max-w-3xl mx-auto mb-8">
        <h2
          id="formats-heading"
          class="text-2xl sm:text-3xl font-extrabold mb-3 tracking-tight"
          style="color: var(--text-primary);"
        >
          {t.formatsGuide.title}
        </h2>
        <p class="ui-lead-text font-medium opacity-90" style="color: var(--text-muted);">
          {t.formatsGuide.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {t.formatsGuide.cards.map((card) => (
          <article
            class="p-6 rounded-3xl border-2"
            style="background-color: var(--bg-surface-card); border-color: var(--border-soft); box-shadow: var(--shadow-card);"
          >
            <h3 class="text-lg sm:text-xl font-extrabold mb-2" style="color: var(--text-primary);">
              {card.title}
            </h3>
            <p class="text-base leading-relaxed opacity-90" style="color: var(--text-primary);">
              {card.text}
            </p>
          </article>
        ))}
      </div>
    </section>

    <!-- Kapwing / Canva / Clideo Alternative Comparison Table -->
    <section aria-labelledby="compare-heading">
      <div class="text-center max-w-3xl mx-auto mb-8">
        <h2
          id="compare-heading"
          class="text-2xl sm:text-3xl font-extrabold mb-3 tracking-tight"
          style="color: var(--text-primary);"
        >
          {t.comparison.title}
        </h2>
        <p class="ui-lead-text font-medium opacity-90" style="color: var(--text-muted);">
          {t.comparison.subtitle}
        </p>
      </div>

      <div
        class="overflow-x-auto rounded-3xl border-2"
        style="background-color: var(--bg-surface-card); border-color: var(--border-color); box-shadow: var(--shadow-card);"
      >
        <table class="w-full min-w-[520px] text-left border-collapse">
          <thead>
            <tr style="background-color: var(--highlight-pill-badge); color: var(--text-primary);">
              <th scope="col" class="px-3.5 py-3 sm:px-5 sm:py-4 text-xs sm:text-base font-extrabold border-b" style="border-color: var(--border-soft);">
                {t.comparison.colFeature}
              </th>
              <th scope="col" class="px-3.5 py-3 sm:px-5 sm:py-4 text-xs sm:text-base font-extrabold border-b" style="border-color: var(--border-soft);">
                {t.comparison.colVideoResizer}
              </th>
              <th scope="col" class="px-3.5 py-3 sm:px-5 sm:py-4 text-xs sm:text-base font-extrabold border-b" style="border-color: var(--border-soft);">
                {t.comparison.colOthers}
              </th>
            </tr>
          </thead>
          <tbody>
            {t.comparison.rows.map((row) => (
              <tr class="border-b last:border-b-0" style="border-color: var(--border-soft);">
                <th scope="row" class="px-3.5 py-3 sm:px-5 sm:py-4 text-xs sm:text-base font-bold" style="color: var(--text-primary);">
                  {row.feature}
                </th>
                <td class="px-3.5 py-3 sm:px-5 sm:py-4 text-xs sm:text-base font-extrabold" style="color: var(--text-primary);">
                  <span
                    class="inline-block px-2.5 sm:px-3 py-1 rounded-xl"
                    style="background-color: var(--highlight-pill-badge); color: var(--text-primary);"
                  >
                    ✓ {row.videoResizer}
                  </span>
                </td>
                <td class="px-3.5 py-3 sm:px-5 sm:py-4 text-xs sm:text-base font-medium opacity-85" style="color: var(--text-primary);">
                  {row.cloudEditors}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- SEO FAQ Section matching FAQPage JSON-LD 1:1 -->
    <section aria-labelledby="faq-heading">
      <h2
        id="faq-heading"
        class="text-2xl sm:text-3xl font-extrabold mb-6 text-center tracking-tight"
        style="color: var(--text-primary);"
      >
        {t.faq.title}
      </h2>

      <div class="space-y-3.5 max-w-3xl mx-auto">
        {t.faq.items.map((item) => (
          <details
            class="group rounded-2xl border-2 px-5 py-4 transition-colors"
            style="background-color: var(--bg-surface-card); border-color: var(--border-soft);"
          >
            <summary
              class="flex items-center justify-between gap-4 cursor-pointer list-none text-base sm:text-lg font-extrabold"
              style="color: var(--text-primary);"
            >
              <span>{item.q}</span>
              <span
                aria-hidden="true"
                class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 transition-transform group-open:rotate-45 font-bold"
                style="background-color: var(--highlight-pill-badge); color: var(--text-primary);"
              >
                +
              </span>
            </summary>
            <p class="mt-3 text-base leading-relaxed opacity-90" style="color: var(--text-primary);">
              {item.a}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <!-- Footer -->
  <footer class="border-t py-8 px-4 text-center" style="border-color: var(--border-soft);">
    <p class="font-bold text-base mb-1" style="color: var(--text-primary);">
      {t.footer.tagline}
    </p>
    <p class="text-sm font-semibold opacity-80" style="color: var(--text-secondary);">
      {t.footer.privacyNote}
    </p>
  </footer>
</div>
