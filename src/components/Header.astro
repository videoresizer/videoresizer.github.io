---
import { LANGUAGES, LOCALE_LIST, getLocalePath, getTranslation, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const homeUrl = getLocalePath(locale);
const currentLang = LANGUAGES[locale];
---

<header
  id="vr-site-header"
  class="sticky top-0 z-40 w-full backdrop-blur-md border-b transition-colors duration-200"
  style="background-color: var(--navbar-bg); border-color: var(--border-soft);"
>
  <nav
    aria-label="Primary Navigation"
    class="max-w-7xl mx-auto px-3 sm:px-4 lg:px-6 h-16 lg:h-[72px] flex items-center justify-between gap-2 lg:gap-3"
  >
    <!-- 1. Brand Logo + Title (Always crisp on mobile, tablet & desktop) -->
    <a
      href={homeUrl}
      aria-label={t.nav.brand}
      class="inline-flex items-center gap-2 sm:gap-2.5 px-1.5 sm:px-2 py-1.5 rounded-xl font-extrabold tracking-tight transition-transform hover:scale-[1.02] shrink-0 min-w-0"
      style="color: var(--text-primary);"
    >
      <span
        class="inline-flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-xl shadow-sm shrink-0"
        style="background-color: #427A5B;"
      >
        <svg width="24" height="24" viewBox="0 0 64 64" fill="none" aria-hidden="true">
          <path d="M14 23V14H23" stroke="#FCF5B8" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M41 14H50V23" stroke="#FCF5B8" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M50 41V50H41" stroke="#FCF5B8" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M23 50H14V41" stroke="#FCF5B8" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
          <path
            d="M27 23.5C27 22.3 28.3 21.6 29.3 22.2L41.5 29.7C42.5 30.3 42.5 31.7 41.5 32.3L29.3 39.8C28.3 40.4 27 39.7 27 38.5V23.5Z"
            fill="#B4CD93"
          />
        </svg>
      </span>
      <span class="text-lg sm:text-xl font-extrabold tracking-tight truncate">
        {t.nav.brand}
      </span>
    </a>

    <!-- DESKTOP NAVBAR CONTROLS (>= 1024px) -->
    <div class="hidden lg:flex items-center justify-end gap-2 xl:gap-2.5 shrink-0">
      <!-- 2. 8-Language Dropdown Selector -->
      <div class="relative" id="vr-lang-wrapper">
        <button
          type="button"
          id="vr-lang-btn"
          aria-label={`${t.nav.languageSelector} (${currentLang.short})`}
          aria-haspopup="listbox"
          aria-expanded="false"
          class="inline-flex items-center gap-1.5 px-2.5 xl:px-3 py-2 rounded-xl border font-semibold text-xs xl:text-sm cursor-pointer transition-colors"
          style="background-color: var(--workspace-box-bg); border-color: var(--border-soft); color: var(--text-primary);"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="w-4 h-4 xl:w-5 xl:h-5 shrink-0"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="M2 12h20" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          <span class="font-bold">{currentLang.short}</span>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="w-3.5 h-3.5 opacity-75"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>

        <ul
          id="vr-lang-menu"
          role="listbox"
          aria-label={t.nav.languageSelector}
          class="hidden absolute right-0 mt-2 w-48 py-1.5 rounded-2xl border shadow-xl z-50"
          style="background-color: var(--workspace-box-bg); border-color: var(--border-color);"
        >
          {LOCALE_LIST.map((code) => {
            const item = LANGUAGES[code];
            const isActive = code === locale;
            return (
              <li role="option" aria-selected={isActive}>
                <a
                  href={getLocalePath(code)}
                  class="flex items-center justify-between px-4 py-2.5 text-sm font-semibold transition-colors"
                  style={
                    isActive
                      ? 'background-color: var(--btn-primary-bg); color: var(--btn-primary-text);'
                      : 'color: var(--text-primary);'
                  }
                >
                  <span>{item.nativeName}</span>
                  <span class="text-xs font-extrabold opacity-80">{item.short}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- 3. Light/Dark Mode Toggle Button -->
      <button
        type="button"
        id="vr-theme-toggle"
        aria-label={t.nav.toggleTheme}
        class="inline-flex items-center justify-center w-10 h-10 xl:w-11 xl:h-11 rounded-xl border cursor-pointer transition-colors"
        style="background-color: var(--workspace-box-bg); border-color: var(--border-soft); color: var(--text-primary);"
      >
        <svg
          id="vr-icon-sun"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.1"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="hidden w-5 h-5"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" />
          <path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" />
          <path d="m19.07 4.93-1.41 1.41" />
        </svg>
        <svg
          id="vr-icon-moon"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.1"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="w-5 h-5"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>

      <!-- 4. GitHub Repo Icon Link -->
      <a
        href="https://github.com/videoresizer/videoresizer.github.io"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.nav.github}
        class="inline-flex items-center justify-center w-10 h-10 xl:w-11 xl:h-11 rounded-xl border transition-colors"
        style="background-color: var(--workspace-box-bg); border-color: var(--border-soft); color: var(--text-primary);"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="w-5 h-5">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
          />
        </svg>
      </a>

      <!-- 5. Install PWA Button ('Add to Home Screen') -->
      <div class="relative">
        <button
          type="button"
          id="vr-pwa-btn"
          aria-label={t.nav.installPwa}
          data-installed-label={t.nav.pwaInstalled}
          data-instructions={t.nav.pwaInstructions}
          class="inline-flex items-center gap-1.5 px-2.5 xl:px-3 py-2 rounded-xl border font-semibold text-xs xl:text-sm cursor-pointer transition-colors"
          style="background-color: var(--workspace-box-bg); border-color: var(--border-soft); color: var(--text-primary);"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.1"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="w-4 h-4 xl:w-5 xl:h-5 shrink-0"
          >
            <path d="M12 3v12" />
            <path d="m7 10 5 5 5-5" />
            <path d="M5 21h14" />
          </svg>
          <span class="whitespace-nowrap" id="vr-pwa-label">{t.nav.installPwa}</span>
        </button>

        <div
          id="vr-pwa-toast"
          role="status"
          class="hidden absolute right-0 mt-2 w-72 p-3.5 rounded-2xl border shadow-xl text-sm font-medium z-50"
          style="background-color: var(--workspace-box-bg); border-color: var(--border-color); color: var(--text-primary);"
        >
          {t.nav.pwaInstructions}
        </div>
      </div>

      <!-- 6. Support the Developer CTA Button -->
      <a
        href="https://kisharadilshan.gumroad.com/coffee"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.nav.supportDevAria}
        class="vr-support-btn inline-flex items-center gap-1.5 xl:gap-2 px-3 xl:px-4 py-2 rounded-xl font-bold text-xs xl:text-sm shrink-0"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.1"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="w-4 h-4 xl:w-5 xl:h-5 shrink-0"
        >
          <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
          <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
          <path d="M9.5 11.7a1.5 1.5 0 0 1 2.2 0l.3.3.3-.3a1.5 1.5 0 0 1 2.2 0 1.6 1.6 0 0 1 0 2.2L12 16.5l-2.5-2.6a1.6 1.6 0 0 1 0-2.2Z" fill="#FCF5B8" stroke="none" />
        </svg>
        <span class="whitespace-nowrap">{t.nav.supportDev}</span>
      </a>
    </div>

    <!-- MOBILE & TABLET TOGGLE ICON (< 1024px) -->
    <div class="flex lg:hidden items-center shrink-0">
      <button
        type="button"
        id="vr-mobile-menu-btn"
        aria-label={t.nav.menuToggle}
        aria-expanded="false"
        aria-controls="vr-mobile-menu"
        class="vr-mobile-toggle-target inline-flex items-center justify-center rounded-xl border-2 cursor-pointer transition-colors"
        style="background-color: var(--workspace-box-bg); border-color: var(--border-color); color: var(--text-primary);"
      >
        <!-- Hamburger Icon -->
        <svg
          id="vr-menu-open-icon"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="w-6 h-6"
        >
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
        <!-- Close X Icon -->
        <svg
          id="vr-menu-close-icon"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="hidden w-6 h-6"
        >
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- MOBILE & TABLET EXPANDABLE NAV PANEL (< 1024px) -->
  <div
    id="vr-mobile-menu"
    class="hidden lg:hidden border-t max-h-[calc(100dvh-64px)] overflow-y-auto px-3 sm:px-5 py-4 shadow-xl"
    style="background-color: var(--workspace-box-bg); border-color: var(--border-color);"
  >
    <div class="max-w-3xl mx-auto space-y-4">
      <!-- Primary Actions Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        <!-- Theme Switcher -->
        <button
          type="button"
          id="vr-mobile-theme-toggle"
          aria-label={t.nav.toggleTheme}
          class="w-full min-h-[48px] flex items-center justify-between gap-3 px-4 py-2.5 rounded-2xl border font-bold text-sm cursor-pointer transition-colors"
          style="background-color: var(--surface-subtle); border-color: var(--border-soft); color: var(--text-primary);"
        >
          <span class="flex items-center gap-2.5 min-w-0">
            <svg
              id="vr-mobile-icon-sun"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.1"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="hidden w-5 h-5 shrink-0"
            >
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2" />
              <path d="M12 20v2" />
              <path d="m4.93 4.93 1.41 1.41" />
              <path d="m17.66 17.66 1.41 1.41" />
              <path d="M2 12h2" />
              <path d="M20 12h2" />
              <path d="m6.34 17.66-1.41 1.41" />
              <path d="m19.07 4.93-1.41 1.41" />
            </svg>
            <svg
              id="vr-mobile-icon-moon"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.1"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="w-5 h-5 shrink-0"
            >
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            </svg>
            <span class="truncate">{t.nav.toggleTheme}</span>
          </span>
        </button>

        <!-- Install PWA -->
        <button
          type="button"
          id="vr-mobile-pwa-btn"
          aria-label={t.nav.installPwa}
          data-installed-label={t.nav.pwaInstalled}
          class="w-full min-h-[48px] flex items-center gap-2.5 px-4 py-2.5 rounded-2xl border font-bold text-sm cursor-pointer transition-colors"
          style="background-color: var(--surface-subtle); border-color: var(--border-soft); color: var(--text-primary);"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.1"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="w-5 h-5 shrink-0"
          >
            <path d="M12 3v12" />
            <path d="m7 10 5 5 5-5" />
            <path d="M5 21h14" />
          </svg>
          <span id="vr-mobile-pwa-label" class="truncate">{t.nav.installPwa}</span>
        </button>

        <!-- GitHub Repo -->
        <a
          href="https://github.com/videoresizer/videoresizer.github.io"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.nav.github}
          class="w-full min-h-[48px] flex items-center gap-2.5 px-4 py-2.5 rounded-2xl border font-bold text-sm transition-colors"
          style="background-color: var(--surface-subtle); border-color: var(--border-soft); color: var(--text-primary);"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="w-5 h-5 shrink-0">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
            />
          </svg>
          <span class="truncate">GitHub</span>
        </a>

        <!-- Support Developer CTA -->
        <a
          href="https://kisharadilshan.gumroad.com/coffee"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t.nav.supportDevAria}
          class="vr-support-btn w-full min-h-[48px] flex items-center justify-center gap-2 px-4 py-2.5 rounded-2xl font-bold text-sm"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.1"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="w-5 h-5 shrink-0"
          >
            <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
            <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
            <path d="M9.5 11.7a1.5 1.5 0 0 1 2.2 0l.3.3.3-.3a1.5 1.5 0 0 1 2.2 0 1.6 1.6 0 0 1 0 2.2L12 16.5l-2.5-2.6a1.6 1.6 0 0 1 0-2.2Z" fill="#FCF5B8" stroke="none" />
          </svg>
          <span class="truncate">{t.nav.supportDev}</span>
        </a>
      </div>

      <div
        id="vr-mobile-pwa-toast"
        role="status"
        class="hidden p-3.5 rounded-2xl border text-sm font-medium"
        style="background-color: var(--highlight-pill-badge); border-color: var(--border-color); color: var(--text-primary);"
      >
        {t.nav.pwaInstructions}
      </div>

      <!-- 8-Language Selector Grid -->
      <div class="pt-2 border-t" style="border-color: var(--border-soft);">
        <div class="flex items-center gap-2 mb-2.5 text-xs font-extrabold uppercase tracking-wider" style="color: var(--text-secondary);">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10" />
            <path d="M2 12h20" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          <span>{t.nav.languageSelector}</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          {LOCALE_LIST.map((code) => {
            const item = LANGUAGES[code];
            const isActive = code === locale;
            return (
              <a
                href={getLocalePath(code)}
                aria-current={isActive ? 'page' : undefined}
                class="min-h-[44px] flex items-center justify-between px-3 py-2 rounded-xl border text-sm font-bold transition-colors"
                style={
                  isActive
                    ? 'background-color: var(--btn-primary-bg); color: var(--btn-primary-text); border-color: transparent;'
                    : 'background-color: var(--surface-subtle); color: var(--text-primary); border-color: var(--border-soft);'
                }
              >
                <span class="truncate">{item.nativeName}</span>
                <span class="text-xs font-extrabold opacity-80 ml-1 shrink-0">{item.short}</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const header = document.getElementById('vr-site-header');

    // 1. Synced Desktop + Mobile/Tablet Theme Switcher
    const themeBtn = document.getElementById('vr-theme-toggle');
    const mobileThemeBtn = document.getElementById('vr-mobile-theme-toggle');
    const iconSun = document.getElementById('vr-icon-sun');
    const iconMoon = document.getElementById('vr-icon-moon');
    const mobileIconSun = document.getElementById('vr-mobile-icon-sun');
    const mobileIconMoon = document.getElementById('vr-mobile-icon-moon');

    function syncThemeIcons() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      if (iconSun && iconMoon) {
        iconSun.classList.toggle('hidden', !isDark);
        iconMoon.classList.toggle('hidden', isDark);
      }
      if (mobileIconSun && mobileIconMoon) {
        mobileIconSun.classList.toggle('hidden', !isDark);
        mobileIconMoon.classList.toggle('hidden', isDark);
      }
    }

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('vr-theme', next);
      } catch {}
      syncThemeIcons();
    }

    syncThemeIcons();

    if (themeBtn) themeBtn.addEventListener('click', toggleTheme);
    if (mobileThemeBtn) mobileThemeBtn.addEventListener('click', toggleTheme);

    // 2. Desktop Language Dropdown
    const langBtn = document.getElementById('vr-lang-btn');
    const langMenu = document.getElementById('vr-lang-menu');
    const langWrapper = document.getElementById('vr-lang-wrapper');

    function closeLangMenu() {
      if (langMenu && langBtn) {
        langMenu.classList.add('hidden');
        langBtn.setAttribute('aria-expanded', 'false');
      }
    }

    if (langBtn && langMenu) {
      langBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const willOpen = langMenu.classList.contains('hidden');
        langMenu.classList.toggle('hidden', !willOpen);
        langBtn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      });

      document.addEventListener('click', (e) => {
        if (langWrapper && !langWrapper.contains(e.target)) {
          closeLangMenu();
        }
      });
    }

    // 3. Mobile & Tablet Menu Toggle (< 1024px)
    const mobileMenuBtn = document.getElementById('vr-mobile-menu-btn');
    const mobileMenu = document.getElementById('vr-mobile-menu');
    const openIcon = document.getElementById('vr-menu-open-icon');
    const closeIcon = document.getElementById('vr-menu-close-icon');

    function setMobileMenuOpen(isOpen) {
      if (!mobileMenu || !mobileMenuBtn) return;
      mobileMenu.classList.toggle('hidden', !isOpen);
      mobileMenuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      if (openIcon && closeIcon) {
        openIcon.classList.toggle('hidden', isOpen);
        closeIcon.classList.toggle('hidden', !isOpen);
      }
    }

    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const willOpen = mobileMenu.classList.contains('hidden');
        setMobileMenuOpen(willOpen);
      });

      document.addEventListener('click', (e) => {
        if (header && !header.contains(e.target) && !mobileMenu.classList.contains('hidden')) {
          setMobileMenuOpen(false);
        }
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024 && !mobileMenu.classList.contains('hidden')) {
          setMobileMenuOpen(false);
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeLangMenu();
        setMobileMenuOpen(false);
      }
    });

    // 4. Synced Desktop + Mobile/Tablet Install PWA ('Add to Home Screen')
    let deferredPrompt = null;
    const pwaBtn = document.getElementById('vr-pwa-btn');
    const pwaLabel = document.getElementById('vr-pwa-label');
    const pwaToast = document.getElementById('vr-pwa-toast');
    const mobilePwaBtn = document.getElementById('vr-mobile-pwa-btn');
    const mobilePwaLabel = document.getElementById('vr-mobile-pwa-label');
    const mobilePwaToast = document.getElementById('vr-mobile-pwa-toast');

    function markInstalled() {
      const installedText = (pwaBtn && pwaBtn.getAttribute('data-installed-label')) ||
        (mobilePwaBtn && mobilePwaBtn.getAttribute('data-installed-label'));
      if (installedText) {
        if (pwaLabel) pwaLabel.textContent = installedText;
        if (mobilePwaLabel) mobilePwaLabel.textContent = installedText;
      }
    }

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
    });

    window.addEventListener('appinstalled', () => {
      deferredPrompt = null;
      markInstalled();
    });

    if (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) {
      markInstalled();
    }

    async function handlePwaClick(toastEl) {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        try {
          await deferredPrompt.userChoice;
        } catch {}
        deferredPrompt = null;
        return;
      }
      if (toastEl) {
        toastEl.classList.toggle('hidden');
        setTimeout(() => {
          toastEl.classList.add('hidden');
        }, 5000);
      }
    }

    if (pwaBtn) pwaBtn.addEventListener('click', () => handlePwaClick(pwaToast));
    if (mobilePwaBtn) mobilePwaBtn.addEventListener('click', () => handlePwaClick(mobilePwaToast));
  })();
</script>
