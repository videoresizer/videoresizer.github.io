---
import '../styles/global.css';
import SeoJsonLd from '../components/SeoJsonLd.astro';
import {
  LANGUAGES,
  LOCALE_LIST,
  TARGET_META_KEYWORDS,
  getLocalePath,
  getTranslation,
  type Locale,
} from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const siteOrigin = 'https://videoresizer.github.io';
const canonicalUrl = `${siteOrigin}${getLocalePath(locale)}`;
const ogImageUrl = `${siteOrigin}/og-image.png`;
const currentOgLocale = LANGUAGES[locale].ogLocale;
const alternateOgLocales = LOCALE_LIST.filter((c) => c !== locale).map((c) => LANGUAGES[c].ogLocale);
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="keywords" content={TARGET_META_KEYWORDS} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#427A5B" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={`${siteOrigin}/sitemap.xml`} />

    {LOCALE_LIST.map((code) => (
      <link rel="alternate" hreflang={code} href={`${siteOrigin}${getLocalePath(code)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}/`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="VideoResizer" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta property="og:locale" content={currentOgLocale} />
    {alternateOgLocales.map((altLoc) => (
      <meta property="og:locale:alternate" content={altLoc} />
    ))}

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={t.meta.ogImageAlt} />

    <!-- Structured Data (Zero Fake Ratings) -->
    <SeoJsonLd locale={locale} />

    <!-- Google Tag Manager (GTM-NR3MJ3G9) & Google Analytics 4 (G-L974XJ0CJ9) -->
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-NR3MJ3G9"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-L974XJ0CJ9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-L974XJ0CJ9');
    </script>

    <!-- Prevent theme FOUC before first paint; light mode is default -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('vr-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NR3MJ3G9"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      ></iframe>
    </noscript>

    <slot />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
